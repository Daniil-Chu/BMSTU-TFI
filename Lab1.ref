HelpCompare {
	'-' s.1 = 0;
	s.1 '+' = 0;
	s.1 s.2 = 1;
	e.1 = "error"
}

A-Z {
	s.1 = <HelpCompare <Compare <Ord s.1> <Ord 'A'>> <Compare <Ord s.1> <Ord 'Z'>>>
}

a-z {
	s.1 = <HelpCompare <Compare <Ord s.1> <Ord 'a'>> <Compare <Ord s.1> <Ord 'z'>>>
}

if {
	0 (e.1) (e.2) = e.2;
	1 (e.1) (e.2) = e.1;
	e.1 = "err1";
}

Marking {
	s.1 e.1 (1) = <if <A-Z s.1> ('}[' s.1 ']' <Marking e.1 >) (s.1 <Marking e.1 (1)>)>;
	s.1 e.1 = <if <A-Z s.1> ('[' s.1 ']' <Marking e.1 >) ('{' s.1 <Marking e.1 (1)>)>;
	/*empty*/  = /*empty*/;
	/*empty*/ (1) = '}';
}

AddEmpty {
	e.1 '[' s.1 '][' s.2 ']' e.2 = <AddEmpty e.1 '[' s.1 ']{}[' s.2 ']' e.2>;
	'[' s.1 ']' e.1 = <AddEmpty '{}[' s.1 ']' e.1>;
	e.1 '[' s.1 ']' = <AddEmpty e.1 '[' s.1 ']{}'>;
	e.1 = e.1
}

Indexation {
	'{' e.1 '}[' s.1 ']' e.2 (s.2) = '{' e.1 '}[' s.1 <Symb s.2> ']'<Indexation  e.2 (<Add s.2 1>)>;
	'{' e.1 '}' (s.1) = '{' e.1 '}'
}

F1 {
	'^' e.1 '$' ' -> ' '^' e.2 '$' = 
	<F2Prep <AddEmpty <Marking e.1>> (<AddEmpty <Marking e.2>>)>
	<F3 <AddEmpty <Marking e.1>>>

}

/*
	{e.1 | >} каретка для поиска слова e.1 движется в право
	{% not | a} - "синтаксический сахар" означает 26 - 1 правило для каждой буквы кроме a, для читаемости правил, {# not | A} аналогично, но для верхнего регистра
	{% a-z} "синтаксический сахар" означает 26 правил для каждой буквы, для читаемости правил
	{% a-z | A-Z | #[]} "синтаксический сахар" означает 26+26+3 правило для каждой буквы любого регистра и спецсимволов [, ], #, для читаемости правил
	{% not | abcde} - "синтаксический сахар" означает 26^5 - 1 правило для каждого слова кроме abcde,
		можно было бы заменить на правила с приоритетом, если слово пустое то правила нет
	{! e.1} проверка нашли ли слово e.1
*/

F2NextW {											/*  поиск слова  */
	'{' e.1 '}' e.2 = '{ ' e.1 '|>}'; 					/* каретка   */
	'[' e.1 ']' e.2 = <F2NextW e.2>;					/* встретили переменную   */
	/*empty*/  = '{$ 0| >}';							/* каретка для следующего этапа   */
}

F2NextP {											
	'{' e.1 '}' e.2 = <F2NextW e.2>; 				
	'[' s.1 ']' e.2 = '#' s.1;					
	/*empty*/  = ;								
}

F2Prep {
	
	(e.3) = <Prout ' -> ' e.3 >							/*  вырожденный случай ^$ -> ^ e.2 $ */
	;
	'{' e.1 '}' s.1 e.2 (e.3) = <F2 s.1 e.2 (<Indexation e.3 (0)>) > 
	<Prout '^' e.1 '-> /' <F2NextW e.2>>					/* стираем первое слово вместе с символом начала строки, создаем каретку для поиска второго слова */
	;  
	'[' s.1 ']' e.2 (e.3) = <F2 '[' s.1 ']' e.2 (<Indexation e.3 (0) >) >		
	<Prout '^ -> /' <F2NextW e.2>>							/* стираем символ начала строки, создаем каретку для поиска второго слова */
	;
	'{' e.1 '}' ('{' e.3 '}') = <Prout e.1 ' -> ' e.3 >			/*  вырожденный случай ^ e.1 $ -> ^ e.2 $ */
	;
}

F2 {
	'[' s.2 ']' '{' e.1 '}' (e.3 '[' s.1 e.4 ']' '{' e.5 '}') =									/* правило кончилось на слово   */
	<F2 (e.3 '[' s.1 e.4 ']' '{' e.5 '}')> 
	<Prout '{$ 0| >}{% a-z}' ' -> ' '{% a-z}{$ 0| >}'>												/* каретка едет до конца   */
	<Prout  e.1 '{$ 0| >}$' ' -> ' s.2 '#{<|find ' s.1 e.4 '#}{open1}{close1}$' >						/* в конце убрали слово и добавили метку переменной, готовим следующий шаг (копирование) */
	
	<Prout '{!newiter}' ' -> ' '{<|' s.2 '#||3s}'>													/* на последней итерации готовим на потом правило для пересопоставления другим образом   */
	<Prout '{$ 0| >}{open1}' ' -> ' s.2 '#{<|find ' s.1 e.4 '#}{open2}{close2}{open1}' >				/* получили очередное сопоставление, готовимся формировать результат сопоставления*/
	;
	'[' s.2 ']' '{' s.1 e.1 '}' e.2 (e.3) = <F2 e.2 (e.3)> 												/* 	правила по левой части для выбора сопоставления   */
	<Prout '{ ' s.1 e.1 ' | >}' '{% not |' s.1 '}' ' -> ' '{% not |' s.1 '}' '{ ' s.1 e.1 ' | >}'> 		/* 	каретка едет пока не найдет первую букву искомого слова   */
	<Prout '{ ' s.1 e.1 ' | >}' s.1 ' -> ' '{!' s.1 e.1 '}' s.1 > 										/* 	нашли первую букву, хотм проверить совпало ли слово целиком   */
	<Prout  '{!' s.1 e.1 '}' s.1 e.1 ' -> ' '#' s.2 '[' s.1 e.1 ']' <F2NextW e.2> > 						/* 	совпало, заворачиваем в [], генерируем следующую каретку ставим метку переменной */
	<Prout  '{!' s.1 e.1 '}' s.1 '{% not | ' e.1 '}' ' -> '  s.1 '{ ' s.1 e.1 ' | >}'> 					/* 	не совпало, ищем дальше    */
	
	<Prout  '{ ' s.1 e.1 ' | >}{open1}' ' -> ' '{!return | ' s.1 e.1 '}{open1}' >							/*  при поиске следующего вхождения слова (1) ничего не нашли, отправляемся за следующим (слева) словом  */
	;
	
	(e.5 '[' s.1 e.4 ']' '{' e.3 '}' '[' s.2 e.2 ']' '{' e.1 '}') = <F2 (e.5 '[' s.1 e.4 ']' '{' e.3 '}')>		/*  	левая часть кончилась,  строим результат для первого сопоставления  */
	<Prout s.2 '#{<|find ' s.2 e.2 '#}' ' -> ' '{pos'  s.2 e.2 '}' '{<|copy}' s.2 '#'>						/*  	нашли искомую переменную, ставим метку начинаем копирование  */
	<Prout '{% not |' s.2 '}' '#{<|find ' s.2 '#}' ' -> ' '{<|find ' s.2 '#}' '{% not |' s.2 '}' '#'>			/* 	нашли другую переменную идем дальше  */
	<Prout '{% a-z | []}' '{<|find ' s.2 '#}' ' -> ' '{<|find ' s.2 '#}' '{% a-z | []}'>						/* 	пропускаем буквы и []  */
	<Prout '{% a-z}{pos'  s.2 e.2 '}{<|copy}' ' -> ' '{pos'  s.2 e.2 '}{% a-z}{% a-z}{copy|>}'>				/*  нашли букву после указателя, сдвинули указатель, копировали букву  */
	<Prout ']{pos'  s.2 e.2 '}{<|copy}' ' -> ' '{$' s.2 e.2 '| >}'>											/* 	указатель уперся в слово, копирование переменной завершено  */
	<Prout '{$' s.2 e.2 '| >}{% a-z | A-Z | #[]}' ' -> ' '{% a-z | A-Z | #[]}{$' s.2 e.2 '| >}'>				/*  идем в конец для того чтобы продолжить копирование  */
	<Prout '{$' s.2 e.2 '| >}{open1}' ' -> ' '{<|find ' s.1 e.4 '#}{open1}' e.3>								/*  	пришли в конец положили слово e.3, готовим следующую итерацию копирования  */
	
	<Prout '{% a-z}{copy|>}{open2}' ' -> ' '{<|copy}{open2}{% a-z}'>											/*  аналогично для второго и последующих сопоставлений  */
	<Prout '{$' s.2 e.2 '| >}{open2}' ' -> ' '{<|find ' s.1 e.4 '#}{open2}' e.3>
	;
	('{' e.1 '}' '[' s.2 e.2 ']' '{' e.3 '}' ) = <F2 ()>
	<Prout s.2 '#{<|find ' s.2 e.2 '#}' ' -> ' '{pos'  s.2 e.2 '}' '{<|copy}' s.2 '#'>						/*  	нашли искомую переменную, ставим метку начинаем копирование  */
	<Prout '{% not |' s.2 '}' '#{<|find ' s.2 '#}' ' -> ' '{<|find ' s.2 '#}' '{% not |' s.2 '}' '#'>			/* 	нашли другую переменную идем дальше  */
	<Prout '{% a-z | []}' '{<|find ' s.2 '#}' ' -> ' '{<|find ' s.2 '#}' '{% a-z | []}'>						/* 	пропускаем буквы и []  */
	<Prout '{% a-z}{pos'  s.2 e.2 '}{<|copy}' ' -> ' '{pos'  s.2 e.2 '}{% a-z}{% a-z}{copy|>}'>				/*  нашли букву после указателя, сдвинули указатель, копировали букву  */
	<Prout '{% a-z}{copy|>}{% a-z | A-Z | #[]}' ' -> ' '{% a-z | A-Z | #[]}{% a-z}{copy|>}'>					/*  тащим букву в конец  */
	<Prout '{% a-z}{copy|>}{open1}' ' -> ' '{<|copy}{open1}{% a-z}'>											/* 	притащили, идем за следующей  */
	<Prout ']{pos'  s.2 e.2 '}{<|copy}' ' -> ' '{$' s.2 e.2 '| >}'>											/* 	указатель уперся в слово, копирование переменной завершено  */
	<Prout '{$' s.2 e.2 '| >}{% a-z | A-Z | #[]}' ' -> ' '{% a-z | A-Z | #[]}{$' s.2 e.2 '| >}'>				/*  идем в конец для того чтобы закончить копирование  */
	<Prout '{$' s.2 e.2 '| >}{open1}' ' -> ' '{!newiter}{open1}' e.1>										/*  получили результат по сопоставлению, готовим получение следующего сопоставления  */
	
	<Prout '{% a-z}{copy|>}{open2}' ' -> ' '{<|copy}{open2}{% a-z}'>
	<Prout '{$' s.2 e.2 '| >}{open2}' ' -> ' '{!comp}{open2}' e.1>											/*  получили результат по сопоставлению, готовим сравнение  */
	;
	/*empty*/ = /*empty*/
	<Prout '{!comp}{open2}' ' -> ' '{open2}{Count}{INC}'>					/*  	сравниваем 2 сопоставления по длине  */
	<Prout '{INC}{% a-z}' ' -> ' '{% a-z}{<|run}{INC}'>
	<Prout '{1}{% a-z}{<|run}' ' -> ' '{% a-z}{<|run}{1}'>
	<Prout '{Count}{% a-z}{<|run}' ' -> ' '{% a-z}{Count}{1}'>
	<Prout '{INC}{close2}{open1}' ' -> ' '{<|run|2}{!wait}'>
	<Prout '{1}{<|run|2}' ' -> ' '{<|run|2}{1}'>
	<Prout '{Count}{<|run|2}' ' -> ' '{close2}{open1}{Count}{2|run|>}'>
	<Prout '{2|run|>}{1}' ' -> ' '{1}{2|run|>}'>
	<Prout '{2|run|>}{!wait}' ' -> ' '{DEC}'>
	<Prout '{1}{DEC}{% a-z}' ' -> ' '{% a-z}{<|run|3}{DEC}'>
	<Prout '{1}{% a-z}{<|run|3}' ' -> ' '{% a-z}{<|run|3}{1}'>
	<Prout '{Count}{% a-z}{<|run|3}' ' -> ' '{% a-z}{Count}'>
	
	<Prout '{Count}{DEC}' ' -> ' '{word 2 win}'>							/*  сравнили  */
	<Prout '{1}{DEC}{close1}' ' -> ' '{word 1 win}'>
	
	<Prout '{word 2 win}{% a-z}' ' -> ' '{word 2 win}'>
	<Prout '{% a-z}{word 2 win}' ' -> ' '{word 2 win}'>
	<Prout '{open1}{word 2 win}{close1}' ' -> ' '{<|run|4}'>
	<Prout '{close2}{<|run|4}' ' -> ' '{<|run|4}{close1}'>
	<Prout '{% a-z}{<|run|4}' ' -> ' '{<|run|4}{% a-z}'>
	<Prout '{open2}{<|run|4}' ' -> ' '{!newiter}{open1}'>					/*  продолжаем  */
	
	<Prout '{% a-z}{word 1 win}' ' -> ' '{word 1 win}{% a-z}'>
	<Prout '{close2}{open1}{word 1 win}' ' -> ' '{EAT}{open1}'>
	<Prout '{% a-z}{EAT}' ' -> ' '{EAT}'>
	<Prout '{open2}{EAT}' ' -> ' '{!newiter}'>								/*  продолжаем  */
	;
	
}

F3 {
	'{' e.1 '}' e.2 '{' e.3 '}' = <F3 e.2>;													/*  убираем граничные слова, с ними уже разобрались  */
	
	e.1 '{' e.2 '}[' s.2 ']{' e.3 '}[' s.1 ']' = <F3 e.1 '{' e.2 '}[' s.2 ']'>										/*    */
	<Prout '{% a-z}{<|' s.1 '#||3s}' ' -> ' '{<|' s.1 '#||3s}{% a-z}'>							/*  каретка движется влево  */
	<Prout '{% A-Z | #]}{<|' s.1 '#||3s}' ' -> ' '{<|' s.1 '#||3s}'>								/*  стираем артефакты предыдущего сопоставления  */
	<Prout s.1 '#[{<|' s.1 '#||3s}{% a-z}' ' -> ' '{% a-z}{ ' e.3 '|>}'>							/*  дошли до конца (левой границы) слова, (1) запускаем поиск другого вхождения */
	<Prout '{!return | ' e.3 '}' ' -> ' '{<|' s.2 '#||3s}'>										/*  другое вхождение не нашлось, ищем для следующего слевога слова  */
	
	
	;
	'[' s.2 ']{' e.3 '}[' s.1 ']' = /*empty*/
	<Prout '{% a-z}{<|' s.1 '#||3s}' ' -> ' '{<|' s.1 '#||3s}{% a-z}'>							/*  каретка движется влево  */
	<Prout '{% A-Z | #]}{<|' s.1 '#||3s}' ' -> ' '{<|' s.1 '#||3s}'>								/*  стираем артефакты предыдущего сопоставления  */
	<Prout s.1 '#[{<|' s.1 '#||3s}{% a-z}' ' -> ' '{% a-z}{ ' e.3 '|>}'>							/*  дошли до конца (левой границы) слова, (1) запускаем поиск другого вхождения */
	<Prout '{!return | ' e.3 '}' ' -> ' '{EAT|1}'>												/*  другое вхождение не нашлось, перебрали все варианты  */
	<Prout '/{EAT|1}{open1}' ' -> ' '/{5|run|>}'>
	<Prout '{5|run|>}{% a-z}' ' -> ' '{% a-z}{5|run|>}'>
	<Prout '{5|run|>}{% ANY other | a-z | $}' ' -> ' '{5|run|>}'>
	<Prout '{5|run|>}$' ' -> ' '{<|run|5}$'>
	<Prout '{% a-z}{<|run|5}' ' -> ' '{<|run|5}{% a-z}'>
	<Prout '/{<|run|5}' ' -> ' '^'>															/*  конец  */
	;
	e.1 = /*empty*/;
}


$ENTRY Go {
  = 
}
